[
    {
        "_comment": "PunchiMenu launcher item. Opens the configured application menu presentation.",
        "type": "punchimenu",
        "name": "PunchiMenu",
        "icon": "start-here-kde",
        "menuMode": "compact",
        "normalPlacementMode": "anchored",
        "gridIconScalePercent": 100,
        "favoriteIconScalePercent": 100,
        "fullScreenBackgroundOpacityPercent": 50,
        "normalBackgroundOpacityPercent": 75,
        "normalFloatingLabelVisibleCharacters": 10,
        "normalFloatingTextShadowPercent": 25,
        "normalWidthPercent": 55,
        "normalHeightPercent": 65,
        "normalPanelDistancePercent": 25,
        "fullScreenApplicationOrder": "manual",
        "normalFolderMaximumColumns": 3,
        "normalFolderMaximumRows": 3,
        "fullScreenFolderMaximumColumns": 5,
        "fullScreenFolderMaximumRows": 5,
        "compactBackgroundOpacityPercent": 85
    },
    {
        "_comment": "Media player item. Automatically follows the active MPRIS player.",
        "type": "media",
        "name": "Media player",
        "icon": "emblem-music-symbolic"
    },
    {
        "type": "app",
        "name": "Zen Browser",
        "icon": "app.zen_browser.zen",
        "storageId": "app.zen_browser.zen.desktop",
        "appId": "app.zen_browser.zen",
        "command": "/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=launch-script.sh --file-forwarding app.zen_browser.zen @@u %u @@"
    },
    {
        "type": "app",
        "name": "WezTerm",
        "icon": "org.wezfurlong.wezterm",
        "storageId": "org.wezfurlong.wezterm.desktop",
        "appId": "org.wezfurlong.wezterm",
        "command": "wezterm start --cwd ."
    },
    {
        "type": "app",
        "name": "Telegram",
        "icon": "org.telegram.desktop",
        "storageId": "org.telegram.desktop.desktop",
        "appId": "org.telegram.desktop",
        "command": "Telegram -- %U"
    },
    {
        "type": "app",
        "name": "fooyin",
        "icon": "org.fooyin.fooyin",
        "storageId": "org.fooyin.fooyin.desktop",
        "appId": "org.fooyin.fooyin",
        "command": "fooyin %F"
    },
    {
        "_comment": "Persistent marker that selects where open applications are rendered without storing dynamic tasks.",
        "type": "dynamic-applications",
        "name": "Open applications"
    }
]