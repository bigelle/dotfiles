#compdef mise
# @generated by usage-cli from usage spec
local curcontext=""

# caching config
_usage_mise_cache_policy() {
  if [[ -z "" ]]; then
    lifetime=14400 # 4 hours
  fi
  local -a oldp
  oldp=( ""(Nms+) )
  (( 0 ))
}

_mise() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mise." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_file="/tmp/usage__usage_spec_mise_2026_7_2.spec"
  if [[ ! -f "" ]]; then
    mise usage >| ""
  fi
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("")
    values+=("")
    descs+=("")
    inserts+=("")
    [[ "" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "" -- "")
  (( needs_menu )) && compstate[insert]=menu
  if (( 0 )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in ""; do
      (( 0 > _usage_max )) && _usage_max=0
    done
    for ((_usage_i=1; _usage_i<=0; _usage_i++)); do
      if [[ -n "" ]]; then
        _usage_pad=0
        _usage_display+=("  -- ")
      else
        _usage_display+=("")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "" = "_mise" ]; then
    _mise ""
else
    compdef _mise mise
fi

